{
  "name": "hiraku-ios",
  "version": "1.0.0",
  "private": true,
  "description": "ひらく島 3D箱庭ゲーム iOSアプリ (Capacitorラッパー)",
  "scripts": {
    "sync-web": "bash sync-web.sh",
    "add-ios": "npm run sync-web && npx cap add ios && npx cap sync ios",
    "sync": "npm run sync-web && npx cap sync ios",
    "open": "npx cap open ios",
    "icons": "npx @capacitor/assets generate --ios --iconBackgroundColor '#3fa8e0' --iconBackgroundColorDark '#3fa8e0' --splashBackgroundColor '#1b2a3a' --splashBackgroundColorDark '#1b2a3a'"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
